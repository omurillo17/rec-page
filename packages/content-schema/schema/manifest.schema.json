{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "ui": {
      "type": "object",
      "properties": {
        "minVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "maxVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "minVersion"
      ],
      "additionalProperties": false
    },
    "assetsBase": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "tutorials": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "published",
              "archived"
            ]
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "access": {
            "default": "public",
            "type": "string",
            "enum": [
              "public",
              "protected"
            ]
          },
          "video": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "default": "video/mp4",
                "type": "string",
                "const": "video/mp4"
              },
              "poster": {
                "type": "string",
                "minLength": 1
              },
              "durationSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "captions": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "type": "string",
                      "minLength": 1
                    },
                    "srclang": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 10
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "default": "captions",
                      "type": "string",
                      "enum": [
                        "captions",
                        "subtitles"
                      ]
                    },
                    "default": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "src",
                    "srclang",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "chapters": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "startSec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "startSec",
                    "title"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "src",
              "durationSec"
            ],
            "additionalProperties": false
          },
          "tourId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "accessibilityNotes": {
            "type": "string"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "module",
          "title",
          "description",
          "status",
          "video"
        ],
        "additionalProperties": false
      }
    },
    "tours": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "published",
              "archived"
            ]
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "src": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "module",
          "title",
          "status",
          "src"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "appId",
    "contentVersion",
    "status",
    "modules"
  ],
  "additionalProperties": false
}
