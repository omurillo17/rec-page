{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "top",
              "right",
              "bottom",
              "left",
              "over"
            ]
          },
          "align": {
            "type": "string",
            "enum": [
              "start",
              "center",
              "end"
            ]
          },
          "optional": {
            "default": false,
            "type": "boolean"
          },
          "waitForMs": {
            "default": 3000,
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "module",
    "title",
    "steps"
  ],
  "additionalProperties": false
}
