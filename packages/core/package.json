{
  "name": "@seventeen-training/core",
  "version": "0.3.0",
  "description": "Framework-agnostic logic: manifest loading/validation, content selection, recommendations, WebVTT parsing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omurillo17/rec-page.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/omurillo17/rec-page#readme",
  "bugs": "https://github.com/omurillo17/rec-page/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@seventeen-training/content-schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
