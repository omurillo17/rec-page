{
  "name": "@seventeen-training/video-renderer",
  "version": "0.3.0",
  "description": "Remotion templates + Node API that turn a structured script and real screenshots into an MP4 draft with synced WebVTT subtitles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omurillo17/rec-page.git",
    "directory": "packages/video-renderer"
  },
  "homepage": "https://github.com/omurillo17/rec-page#readme",
  "bugs": "https://github.com/omurillo17/rec-page/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "remotion studio src/remotion/index.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@seventeen-training/core": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
