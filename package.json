{
  "name": "seventeen-training-kit",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./tools/** run build",
    "test": "pnpm build && vitest run",
    "typecheck": "pnpm -r run typecheck",
    "training": "node tools/training-cli/dist/cli.js",
    "dev:html": "pnpm --filter demo-html dev",
    "dev:react": "pnpm --filter demo-react dev",
    "skills:install": "node skills/install.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
